# BuildBox code style - tabs for indentation, shown 4 columns wide.
# Generated files (display/resources/, features/keycodes_list.h) are left as generated.
root = false

[*.{c,h,js,css,html}]
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true
